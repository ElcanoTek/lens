{
  "_comment": "Copy to config.json (git-ignored) and edit. Every key below is optional — omit one and the default shown here applies. Secrets do NOT belong in this file; they live in .env (see .env.example). Keys are read by internal/config (lens run reads config.json from its working directory; lens serve from the Lens home).",

  "_comment_paths": "File paths for a CLI run. The web dashboard overrides all four per job, so these matter only when you run `lens run` directly.",
  "input_csv_path": "input.csv",
  "output_csv_path": "output.csv",
  "progress_file_path": "progress.json",
  "log_file_path": "site_analysis.log",

  "_comment_llm": "Classification via OpenRouter. The default ~openai/gpt-luna-latest alias tracks the current GPT Luna model. llm_fallback_model is used when the primary is unavailable. A config.json that still names the previous shipped default (~google/gemini-flash-latest) is upgraded on load.",
  "llm_model": "~openai/gpt-luna-latest",
  "llm_fallback_model": "~openai/gpt-mini-latest",
  "llm_temperature": 0.1,
  "llm_max_tokens": 1500,
  "llm_request_max_retries": 3,
  "llm_request_timeout": 60,

  "_comment_scraping": "Website crawling. scrape_mode: auto (full rescue ladder: direct → deep → research), direct (plain HTTP only), deep (headless Chrome only). min_content_length is the shortest page body accepted as real content. reject_redirects fails URLs that redirect off-host in the direct pass.",
  "scrape_mode": "auto",
  "concurrent_sessions": 5,
  "request_timeout": 30,
  "max_retries": 3,
  "retry_delay": 2,
  "session_timeout": 300,
  "min_content_length": 500,
  "reject_redirects": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36",

  "_comment_deep": "Second rung: headless Chrome (WebDriver) in a rootless Podman container, one session at a time. Requires podman on PATH; skipped when Podman is unavailable. The fully qualified image name avoids Podman short-name prompts. skip_deep_retry_on_block skips sites the direct pass proved are anti-bot blocked (401/403/429 or a block page) rather than retrying them from the same IP. retry_follow_redirects lets this pass follow cross-host redirects (e.g. foxnewsdigital.com -> foxnews.com) that the direct pass rejects.",
  "skip_deep_retry_on_block": true,
  "deep_retry_enabled": false,
  "retry_follow_redirects": true,
  "deep_scrape_podman_binary": "podman",
  "deep_scrape_image": "docker.io/selenium/standalone-chrome:latest",
  "deep_scrape_container_name": "elcano-lens-chromedriver",
  "deep_scrape_port": 4444,
  "deep_scrape_vnc_port": 7900,
  "deep_scrape_extra_args": [],
  "deep_scrape_startup_timeout": 45,
  "deep_scrape_wait_after_load": 1.0,
  "deep_scrape_keep_container": false,
  "deep_scrape_pull_policy": "always",

  "_comment_research": "Third and final rung: sites that block every crawler are classified from a web-search research summary instead of being marked Failed. The site is never contacted from this host. Needs a model with built-in web search.",
  "research_fallback_enabled": true,
  "research_model": "perplexity/sonar",
  "decision_model": "~typesafe/jev-latest",
  "research_temperature": 0.2,
  "research_max_tokens": 1500,
  "research_max_concurrent": 12,

  "_comment_ios": "iOS App Store (iTunes Search API). Deliberately conservative — the API rate-limits aggressively.",
  "ios_request_timeout": 30,
  "ios_request_delay": 5.0,
  "ios_max_concurrent": 1,
  "ios_max_retries": 3,
  "ios_retry_delay": 3.0,

  "_comment_android": "Google Play Store HTML scraper. Even more conservative — Play blocks fast scrapers.",
  "android_request_timeout": 30,
  "android_request_delay": 10.0,
  "android_max_concurrent": 1,
  "android_max_retries": 3,
  "android_retry_delay": 5.0,

  "_comment_ctv": "Connected-TV pipeline (two steps: research the app, then classify the research). CTV apps have no scrapeable page, so research is not a fallback here — it is the only data source.",
  "ctv_research_model": "perplexity/sonar",
  "ctv_research_temperature": 0.3,
  "ctv_research_max_tokens": 2000,
  "ctv_classification_model": "~openai/gpt-luna-latest",
  "ctv_classification_fallback_model": "~openai/gpt-mini-latest",
  "ctv_classification_temperature": 0.1,
  "ctv_classification_max_tokens": 1500,
  "ctv_max_concurrent": 5,
  "ctv_request_delay": 1.0,
  "ctv_max_retries": 3,
  "ctv_retry_delay": 2.0
}
