{
  "_comment": "Copy to config.json (git-ignored) and edit. Every key below is optional — omit one and the default shown here applies. Secrets do NOT belong in this file; they live in .env (see .env.example). Keys are read by config.py and exposed uppercased on the global `config` singleton.",

  "_comment_paths": "File paths for a CLI run. The web dashboard overrides all four per job, so these matter only when you run `python main.py` directly.",
  "input_csv_path": "input.csv",
  "output_csv_path": "output.csv",
  "progress_file_path": "progress.json",
  "log_file_path": "site_analysis.log",

  "_comment_llm": "Classification via OpenRouter. `~vendor/...-latest` aliases auto-track the vendor's current model. llm_fallback_model is used when the primary is unavailable.",
  "llm_model": "~google/gemini-flash-latest",
  "llm_fallback_model": "~openai/gpt-mini-latest",
  "llm_temperature": 0.1,
  "llm_max_tokens": 1500,
  "llm_request_max_retries": 3,
  "llm_request_timeout": 60,

  "_comment_scraping": "Website crawling. scrape_mode: auto (full rescue ladder), direct (plain HTTP only), deep (headless Chrome only), firecrawl (Firecrawl service only). min_content_length is the shortest page body accepted as real content. reject_redirects fails URLs that redirect off-host in the direct pass.",
  "scrape_mode": "auto",
  "concurrent_sessions": 5,
  "request_timeout": 30,
  "max_retries": 3,
  "retry_delay": 2,
  "session_timeout": 300,
  "min_content_length": 500,
  "reject_redirects": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36",

  "_comment_firecrawl": "Self-hosted Firecrawl stack (firecrawl/docker-compose.yaml, started by scripts/firecrawl.sh up). In auto mode it is the second rung of the ladder. firecrawl_proxy stays \"basic\" on purpose: \"auto\" escalates to a stealth proxy that a self-hosted stack does not have, which only re-hammers hardened sites. skip_deep_retry_on_block avoids retrying an anti-bot block from the same IP.",
  "firecrawl_enabled": true,
  "firecrawl_url": "http://127.0.0.1:3002",
  "firecrawl_timeout": 60,
  "firecrawl_wait_for": 0,
  "firecrawl_max_age_ms": null,
  "firecrawl_max_concurrent": 3,
  "firecrawl_proxy": "basic",
  "firecrawl_follow_redirects": true,
  "skip_deep_retry_on_block": true,

  "_comment_deep": "Third rung: headless Chrome (Selenium) in a rootless Podman container. Requires podman on PATH. The fully qualified image name avoids Podman short-name prompts.",
  "deep_scrape_podman_binary": "podman",
  "deep_scrape_image": "docker.io/selenium/standalone-chrome:latest",
  "deep_scrape_container_name": "elcano-lens-chromedriver",
  "deep_scrape_port": 4444,
  "deep_scrape_vnc_port": 7900,
  "deep_scrape_extra_args": [],
  "deep_scrape_startup_timeout": 45,
  "deep_scrape_wait_after_load": 1.0,
  "deep_scrape_keep_container": false,
  "deep_scrape_pull_policy": "always",

  "_comment_research": "Fourth and final rung: sites that block every crawler are classified from a web-search research summary instead of being marked Failed. The site is never contacted from this host. Needs a model with built-in web search.",
  "research_fallback_enabled": true,
  "research_model": "perplexity/sonar-pro",
  "research_temperature": 0.2,
  "research_max_tokens": 1500,
  "research_max_concurrent": 4,

  "_comment_ios": "iOS App Store (iTunes Search API). Deliberately conservative — the API rate-limits aggressively.",
  "ios_request_timeout": 30,
  "ios_request_delay": 5.0,
  "ios_max_concurrent": 1,
  "ios_max_retries": 3,
  "ios_retry_delay": 3.0,

  "_comment_android": "Google Play Store HTML scraper. Even more conservative — Play blocks fast scrapers.",
  "android_request_timeout": 30,
  "android_request_delay": 10.0,
  "android_max_concurrent": 1,
  "android_max_retries": 3,
  "android_retry_delay": 5.0,

  "_comment_ctv": "Connected-TV pipeline (two steps: research the app, then classify the research). CTV apps have no scrapeable page, so research is not a fallback here — it is the only data source.",
  "ctv_research_model": "perplexity/sonar-pro",
  "ctv_research_temperature": 0.3,
  "ctv_research_max_tokens": 2000,
  "ctv_classification_model": "~google/gemini-flash-latest",
  "ctv_classification_fallback_model": "~openai/gpt-mini-latest",
  "ctv_classification_temperature": 0.1,
  "ctv_classification_max_tokens": 1500,
  "ctv_max_concurrent": 5,
  "ctv_request_delay": 1.0,
  "ctv_max_retries": 3,
  "ctv_retry_delay": 2.0
}
