# Lens environment variables — copy to `.env` and fill in.
#
# `.env` is git-ignored and loaded automatically by python-dotenv (config.py).
# Everything here is a secret or a per-host setting; tuning knobs live in
# config.json instead (see config.json.example).

# ── Required ─────────────────────────────────────────────────────────────
# OpenRouter API key. Every classification goes through OpenRouter, so the
# pipeline refuses to start without it and runs cost real money.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key

# ── Web dashboard only (web_service.py) ──────────────────────────────────
# Ed25519 PUBLIC key of the auth service that mints the session cookie,
# base64-encoded (32 raw bytes). The dashboard only verifies signatures, so
# this key cannot mint a session and is safe to distribute. Leave it unset
# for CLI-only use; without it the dashboard bounces every request to the
# login URL below.
AUTH_SIGNING_PUBKEY=base64-encoded-ed25519-public-key

# Where unauthenticated browsers are sent to sign in. Defaults to
# https://auth.elcanotek.com; point it at your own auth service.
#AUTH_LOGIN_URL=https://auth.example.com

# Name of the session cookie to verify. Defaults to `elcano_auth`.
#AUTH_COOKIE_NAME=elcano_auth

# ── Optional ─────────────────────────────────────────────────────────────
# Extra per-item CLI diagnostics (size, retries, cache status). Same effect
# as `main.py --verbose`. Accepts 1/true/yes/on.
#SCRAPER_VERBOSE=0
