# Runtime artifacts and local configuration — never commit these. They hold
# the identifiers you analyze and the results of those runs.
input.csv
sample_input.csv
output.csv
config.json
progress.json
site_analysis.log
*.log
managed-files/
# Breakdown cache sidecars
managed-files/inputs/.breakdowns/
# Legacy auth DB location (the live one is /var/lib/lens/access.db)
/data/

# Secrets and local environment
.env
.env.*
!.env.example
.envrc

# Go build output, coverage and test binaries
/bin/
coverage.out
coverage.html
*.test
*.prof
/dist/

# Deployment leftovers on a box that tracks this tree
/.deployed-revision
/.venv/
/.venv.old/

# Local design references (not part of the app)
Lens Updates/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Python reference tree (removed at the end of the Go rewrite)
__pycache__/
*.pyc
