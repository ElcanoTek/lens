# Caddy site block for Lens, imported by /etc/caddy/Caddyfile via
# a glob it already imports (Fedora: Caddyfile.d/*.caddyfile; otherwise
# conf.d/*.caddy). Keep this first line: bootstrap uses it to recognise its
# own file. bootstrap.sh substitutes {{HOSTNAME}} and injects `tls internal`
# when Let's Encrypt is disabled.

{{HOSTNAME}} {
	reverse_proxy 127.0.0.1:8808

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
	}
}
