[Unit]
Description=Lens — domain/app scraper web UI
After=network.target

[Service]
Type=simple
User=lens
Group=lens
WorkingDirectory=/opt/lens
EnvironmentFile=/opt/lens/.env
StateDirectory=lens
StateDirectoryMode=0750
# Loopback only: Caddy (or nginx) terminates TLS in front and is the only
# client trusted for X-Forwarded-* headers. The working directory is the Lens
# home (.env, config.json, managed-files/).
ExecStart=/opt/lens/bin/lens serve --addr 127.0.0.1:8808
Restart=always
RestartSec=5

# Hardening — trimmed to what rootless podman (the deep-scrape Chrome
# container) tolerates. Verified empirically; each removed directive broke a
# different layer of rootless podman:
#   NoNewPrivileges=true        blocks the setuid newuidmap/newgidmap helpers
#                               (user-namespace setup fails)
#   ProtectControlGroups=true   blocks creating container cgroups
#   ProtectKernelTunables=true  blocks crun writing net sysctls in the netns
#   PrivateTmp=true             podman's pause process pins the mount ns to a
#                               per-start /var/tmp that dies on restart
#   ProtectHome=true            hides /run/user (rootless runtime root)
ProtectKernelModules=true
ProtectSystem=full
ReadWritePaths=/opt/lens /var/lib/lens
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true

[Install]
WantedBy=multi-user.target
