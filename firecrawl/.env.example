# Copy to firecrawl/.env to override defaults. Everything works without it.

# The stack tracks `latest` and is refreshed on every `lens update`; queue
# state is disposable, so broken upgrades self-heal (see scripts/firecrawl.sh).
# Pin a release here only if a deployment needs reproducibility:
#FIRECRAWL_TAG=latest
#PLAYWRIGHT_SERVICE_TAG=latest
#NUQ_POSTGRES_TAG=latest

# Host port the Firecrawl API binds to on 127.0.0.1
#FIRECRAWL_PORT=3002

# Worker fan-out (defaults tuned for a 2 vCPU / 8 GB host)
#NUM_WORKERS_PER_QUEUE=2
#MAX_CONCURRENT_JOBS=5
#CRAWL_CONCURRENT_REQUESTS=5
#BROWSER_POOL_SIZE=2
#MAX_CONCURRENT_PAGES=3

# Postgres credentials for the internal queue database
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=postgres
#POSTGRES_DB=postgres

# Residential/ISP proxy for the headless browser (optional).
#
# Self-hosted Firecrawl renders from THIS host's IP. Hardened sites behind
# Cloudflare / DataDome / PerimeterX (reuters.com, bloomberg.com, wsj.com,
# economist.com, politico.com, barrons.com, marketwatch.com, …) block
# datacenter IPs outright, so those scrapes fail fast by design no matter how
# the stack is tuned. The only reliable way to reach them is to route the
# browser through a residential or ISP proxy — set it here and `lens update`
# / `scripts/firecrawl.sh up` will pick it up.
#
# Do NOT try to beat anti-bot by hammering harder (more retries, stealth
# escalation): repeated hits from one IP are what turn a soft block into a
# permanent ban. Lens already fails these fast to avoid that.
#PROXY_SERVER=http://proxy.example.com:8080
#PROXY_USERNAME=your-user
#PROXY_PASSWORD=your-pass
